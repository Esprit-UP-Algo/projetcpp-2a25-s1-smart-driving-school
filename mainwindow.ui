          <widget class="QCalendarWidget" name="calendar">
           <property name="geometry">
            <rect>
             <x>10</x>
             <y>10</y>
             <width>631</width>
             <height>351</height>
            </rect>
           </property>
           <property name="styleSheet">
            <string notr="true">/* ===== QCalendarWidget – thème NovaDrive (vert) ===== */

/* Fond global */
QCalendarWidget {
    background-color: white;
    border: 1px solid rgb(41,127,110);
    border-radius: 6px;
    padding: 4px;
    color: rgb(41,127,110);
    font-size: 14px;
}

/* Barre de navigation (mois/année + flèches) */
QCalendarWidget QWidget#qt_calendar_navigationbar {
    background-color: rgb(41,127,110);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 4px;
}

/* Boutons de navigation (flèches) */
QCalendarWidget QToolButton {
    background: transparent;
    color: white;
    padding: 4px 8px;
    border-radius: 4px;
    font-weight: 600;
}
QCalendarWidget QToolButton:hover {
    background: rgba(255,255,255,0.15);
}

/* Mois / Année (spinbox / menu) */
QCalendarWidget QSpinBox,
QCalendarWidget QComboBox {
    background: white;
    color: rgb(41,127,110);
    border: 1px solid rgba(255,255,255,0.0);
    border-radius: 4px;
    padding: 2px 6px;
    font-weight: 600;
}

/* En-têtes des jours (L, M, M, J, V, S, D) */
QCalendarWidget QTableView QHeaderView::section {
    background-color: rgb(41,127,110);
    color: white;
    border: none;
    padding: 4px;
    font-weight: 600;
}

/* Cellules des jours */
QCalendarWidget QAbstractItemView {
    outline: none;
    selection-background-color: rgba(41,127,110,0.12);
    selection-color: rgb(41,127,110);
    gridline-color: rgba(41,127,110,0.25);
    background: white;
}

/* Jour sélectionné */
QCalendarWidget QAbstractItemView:enabled:item:selected {
    background: rgba(41,127,110,0.13);
    color: rgb(41,127,110);
}

/* Aujourd'hui (si non sélectionné) */
QCalendarWidget QWidget#qt_calendar_calendarview::item:hover {
    background: rgba(41,127,110,0.08);
}

/* Jours du mois précédent/suivant (grisés) */
QCalendarWidget QAbstractItemView:enabled:item {
    color: rgb(41,127,110);
}
QCalendarWidget QAbstractItemView:enabled:item:!active {
    color: rgba(41,127,110,0.8);
}
QCalendarWidget QAbstractItemView:enabled:item:alternate {
    color: rgba(41,127,110,0.55);
}
</string>
           </property>
          </widget>
          <widget class="QListWidget" name="listDay">
           <property name="geometry">
            <rect>
             <x>700</x>
             <y>20</y>
             <width>301</width>
             <height>341</height>
            </rect>
           </property>
           <property name="styleSheet">
            <string notr="true">/* Conteneur */
QListWidget {
    background: #ffffff;
    color: rgb(41,127,110);                 /* texte vert */
    border: 1px solid rgb(41,127,110);
    border-radius: 8px;
    padding: 4px;
    outline: none;                          /* pas de halo bleu moche */
}

/* Lignes */
QListWidget::item {
    padding: 8px 10px;
    margin: 2px 6px;                        /* espace entre les “pills” */
    border-radius: 6px;
}

/* Survol */
QListWidget::item:hover {
    background: rgba(41,127,110, 0.10);
}

/* Sélection */
QListWidget::item:selected {
    background: rgb(41,127,110);
    color: #ffffff;
}

/* Sélection quand la liste n’a pas le focus (plus doux) */
QListWidget::item:selected:!active {
    background: rgba(41,127,110, 0.80);
}

/* Alternance (si activée côté code) */
QListWidget::item:alternate {
    background: #fafafa;
}

/* Scrollbar verticale (sobre) */
QScrollBar:vertical {
    background: transparent;
    width: 12px;
    margin: 4px 0;
}
QScrollBar::handle:vertical {
    background: rgba(41,127,110, 0.45);
    min-height: 24px;
    border-radius: 6px;
}
QScrollBar::handle:vertical:hover {
    background: rgba(41,127,110, 0.65);
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;                            /* pas de boutons +/- */
}
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}
</string>
           </property>
          </widget>
